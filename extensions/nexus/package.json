{
  "x-generated": "scripts/merge-contributes.mjs — do not edit contributes by hand",
  "name": "nexus",
  "displayName": "Nexus",
  "description": "Code, team chat, and coding agents in one place.",
  "version": "0.0.1",
  "publisher": "nexus",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.145.2"
  },
  "main": "./out/extension.js",
  "scripts": {
    "build": "npm run contributes && tsc -p tsconfig.json && npm run build:webviews",
    "build:webviews": "node scripts/build-webviews.mjs",
    "watch": "concurrently \"tsc -w -p tsconfig.json\" \"vite build --watch\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webviews/tsconfig.json",
    "lint": "eslint src webviews --ext .ts,.tsx",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "contributes": "node scripts/merge-contributes.mjs",
    "contributes:check": "node scripts/check-contributes.mjs",
    "ci": "npm ci && npm run contributes:check && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.3.0",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.145.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "activationEvents": [
    "onCustomEditor:nexus.home",
    "onStartupFinished",
    "onUri",
    "onView:nexus.approvals",
    "onView:nexus.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexus",
          "title": "Nexus",
          "icon": "resources/nexus.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "nexus.home",
        "displayName": "Nexus Home",
        "selector": [
          {
            "filenamePattern": "*.nexushome"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "nexus.connectProvider",
        "title": "Nexus: Connect provider"
      },
      {
        "command": "nexus.pickModel",
        "title": "Nexus: Pick model"
      },
      {
        "command": "nexus.signIn",
        "title": "Nexus: Sign in (Auth0)"
      },
      {
        "command": "nexus.signOut",
        "title": "Nexus: Sign out"
      },
      {
        "command": "nexus.dev.reseedDemoRepo",
        "title": "Nexus (dev): Re-seed demo repo"
      },
      {
        "command": "nexus.approve",
        "title": "Nexus: Approve"
      },
      {
        "command": "nexus.reject",
        "title": "Nexus: Reject"
      },
      {
        "command": "nexus.makeTaskFromThread",
        "title": "Nexus: Make task from thread"
      },
      {
        "command": "nexus.decomposeTask",
        "title": "Nexus: Break into subtasks"
      },
      {
        "command": "nexus.rerunSwarmReview",
        "title": "Nexus: Re-run swarm review"
      },
      {
        "command": "nexus.toggleOptimizer",
        "title": "Nexus: Toggle Optimize with Prune"
      },
      {
        "command": "nexus.cancelSession",
        "title": "Nexus: Cancel agent session"
      },
      {
        "command": "nexus.connectSlack",
        "title": "Nexus: Connect Slack"
      },
      {
        "command": "nexus.showIdentity",
        "title": "Nexus: Show Slack posting identity"
      },
      {
        "command": "nexus.openCodeRef",
        "title": "Nexus: Open code reference"
      },
      {
        "command": "nexus.shareSelectionToSlack",
        "title": "Nexus: Share to Slack"
      },
      {
        "command": "nexus.openHome",
        "title": "Nexus: Open Home"
      },
      {
        "command": "nexus.searchEvents",
        "title": "Nexus: Search events"
      },
      {
        "command": "nexus.openTimeline",
        "title": "Nexus: Open timeline (globe fallback)"
      },
      {
        "command": "nexus.openSlack",
        "title": "Nexus: Open Slack"
      },
      {
        "command": "nexus.openApprovals",
        "title": "Nexus: Open approvals"
      },
      {
        "command": "nexus.openSession",
        "title": "Nexus: Open session"
      },
      {
        "command": "nexus.openCommit",
        "title": "Nexus: Open commit"
      },
      {
        "command": "nexus.mergeAgentBranch",
        "title": "Nexus: Merge agent branch"
      },
      {
        "command": "nexus.openReceipt",
        "title": "Nexus: Open Prune receipt"
      }
    ],
    "configuration": {
      "title": "Nexus",
      "properties": {
        "nexus.auth0.domain": {
          "type": "string",
          "default": "dev-1l215or4g4k2ol1x.us.auth0.com",
          "description": "Auth0 tenant host name, for example your-tenant.eu.auth0.com (no https://)."
        },
        "nexus.auth0.clientId": {
          "type": "string",
          "default": "HSwYeHumwswQK0MWUQJX9zOiiSB6yC0k",
          "description": "Client ID of the Auth0 Native application. Not a secret."
        },
        "nexus.auth0.audience": {
          "type": "string",
          "default": "https://nexus-api",
          "description": "Optional API audience to request in the access token."
        },
        "nexus.ciba.serviceUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Nexus auth service. Phone approval (Auth0 push) is off until this is set and you are signed in."
        },
        "nexus.agent.allowedCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "Commands an agent may run in its worktree without asking, matched exactly (for example \"npm test\"). Everything else needs a human approval. User settings only: a repository's workspace settings cannot add to it."
        },
        "nexus.slack.auth0Connection": {
          "type": "string",
          "default": "sign-in-with-slack",
          "scope": "application",
          "description": "The Auth0 connection that links Slack, used to get your Slack token from Auth0 Token Vault. User settings only."
        },
        "nexus.t0": {
          "type": "string",
          "default": "",
          "description": "The hackathon's start time (ISO 8601, for example 2026-11-06T22:00:00-05:00), used for T+ times."
        }
      }
    },
    "themes": [
      {
        "label": "Nexus Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/nexus-dark.json"
      }
    ],
    "views": {
      "nexus": [
        {
          "type": "webview",
          "id": "nexus.chat",
          "name": "Slack"
        },
        {
          "type": "webview",
          "id": "nexus.approvals",
          "name": "Approvals"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "nexus.shareSelectionToSlack",
          "when": "editorHasSelection",
          "group": "nexus"
        }
      ],
      "commandPalette": [
        {
          "command": "nexus.openSession",
          "when": "false"
        }
      ]
    }
  }
}
