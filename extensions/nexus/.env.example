# Copy to .env (same folder) and fill in. .env is gitignored; never commit real values.
# Read only by the integration tests (npm run test:int). Tests for a provider skip themselves when its key is empty.

# Anthropic Console API key
ANTHROPIC_API_KEY=
# Optional: model to test against
ANTHROPIC_MODEL=

# Google AI Studio key (billing-enabled project for anything but the fake demo repo)
GEMINI_API_KEY=
# Optional: model to test against
GEMINI_MODEL=

# Swarms API key
SWARMS_API_KEY=
