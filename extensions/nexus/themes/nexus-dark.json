{
  "$schema": "vscode://schemas/color-theme",
  "name": "Nexus Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#9d6bff",
    "foreground": "#d4d4d8",
    "descriptionForeground": "#8b8b96",
    "errorForeground": "#f14c4c",
    "icon.foreground": "#b0b0ba",
    "widget.border": "#2e2e36",
    "contrastBorder": "#2e2e36",
    "selection.background": "#9d6bff55",

    "editor.background": "#0e0e11",
    "editor.foreground": "#d4d4d8",
    "editor.lineHighlightBackground": "#17171c",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#9d6bff44",
    "editor.inactiveSelectionBackground": "#9d6bff22",
    "editor.findMatchBackground": "#9d6bff77",
    "editor.findMatchHighlightBackground": "#9d6bff33",
    "editor.wordHighlightBackground": "#9d6bff22",
    "editorCursor.foreground": "#b794ff",
    "editorLineNumber.foreground": "#4a4a55",
    "editorLineNumber.activeForeground": "#b794ff",
    "editorIndentGuide.background1": "#1e1e24",
    "editorIndentGuide.activeBackground1": "#3a3a46",
    "editorWhitespace.foreground": "#26262d",
    "editorGroup.border": "#2e2e36",
    "editorGroupHeader.tabsBackground": "#0b0b0e",
    "editorWidget.background": "#14141a",
    "editorWidget.border": "#2e2e36",
    "editorSuggestWidget.selectedBackground": "#9d6bff33",

    "tab.activeBackground": "#0e0e11",
    "tab.inactiveBackground": "#0b0b0e",
    "tab.activeForeground": "#f0f0f4",
    "tab.inactiveForeground": "#8b8b96",
    "tab.border": "#2e2e36",
    "tab.activeBorderTop": "#9d6bff",
    "tab.hoverBackground": "#17171c",

    "activityBar.background": "#0b0b0e",
    "activityBar.foreground": "#f0f0f4",
    "activityBar.inactiveForeground": "#6b6b78",
    "activityBar.border": "#2e2e36",
    "activityBar.activeBorder": "#9d6bff",
    "activityBarBadge.background": "#9d6bff",
    "activityBarBadge.foreground": "#0b0b0e",

    "sideBar.background": "#0b0b0e",
    "sideBar.foreground": "#c4c4cc",
    "sideBar.border": "#2e2e36",
    "sideBarTitle.foreground": "#b794ff",
    "sideBarSectionHeader.background": "#111115",
    "sideBarSectionHeader.border": "#2e2e36",

    "list.activeSelectionBackground": "#9d6bff33",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#9d6bff1f",
    "list.hoverBackground": "#17171c",
    "list.focusOutline": "#9d6bff",
    "list.highlightForeground": "#b794ff",
    "tree.indentGuidesStroke": "#2e2e36",

    "titleBar.activeBackground": "#0b0b0e",
    "titleBar.activeForeground": "#d4d4d8",
    "titleBar.inactiveBackground": "#0b0b0e",
    "titleBar.inactiveForeground": "#6b6b78",
    "titleBar.border": "#2e2e36",
    "menu.background": "#14141a",
    "menu.selectionBackground": "#9d6bff33",
    "menubar.selectionBackground": "#9d6bff33",

    "statusBar.background": "#7b4de0",
    "statusBar.foreground": "#ffffff",
    "statusBar.border": "#00000000",
    "statusBar.noFolderBackground": "#2e2e36",
    "statusBar.debuggingBackground": "#c7742b",
    "statusBarItem.hoverBackground": "#ffffff22",
    "statusBarItem.remoteBackground": "#5a34b8",

    "panel.background": "#0b0b0e",
    "panel.border": "#2e2e36",
    "panelTitle.activeBorder": "#9d6bff",
    "panelTitle.activeForeground": "#f0f0f4",
    "panelTitle.inactiveForeground": "#8b8b96",

    "button.background": "#9d6bff",
    "button.foreground": "#0b0b0e",
    "button.hoverBackground": "#b794ff",
    "button.secondaryBackground": "#1e1e24",
    "button.secondaryForeground": "#d4d4d8",
    "button.secondaryHoverBackground": "#2a2a33",
    "button.border": "#2e2e36",

    "input.background": "#14141a",
    "input.foreground": "#d4d4d8",
    "input.border": "#2e2e36",
    "input.placeholderForeground": "#6b6b78",
    "inputOption.activeBackground": "#9d6bff44",
    "inputOption.activeBorder": "#9d6bff",
    "dropdown.background": "#14141a",
    "dropdown.border": "#2e2e36",
    "checkbox.background": "#14141a",
    "checkbox.border": "#2e2e36",
    "badge.background": "#9d6bff",
    "badge.foreground": "#0b0b0e",
    "progressBar.background": "#9d6bff",
    "scrollbarSlider.background": "#3a3a4666",
    "scrollbarSlider.hoverBackground": "#4a4a5699",
    "scrollbarSlider.activeBackground": "#9d6bff88",
    "textLink.foreground": "#b794ff",
    "textLink.activeForeground": "#d4bfff",
    "textBlockQuote.border": "#9d6bff",
    "peekView.border": "#9d6bff",
    "peekViewEditor.background": "#101015",
    "peekViewResult.background": "#0b0b0e",

    "terminal.background": "#0b0b0e",
    "terminal.foreground": "#d4d4d8",
    "terminalCursor.foreground": "#b794ff",
    "terminal.ansiGreen": "#3fb950",
    "terminal.ansiRed": "#f14c4c",
    "terminal.ansiYellow": "#d9a520",
    "terminal.ansiMagenta": "#b794ff",

    "gitDecoration.modifiedResourceForeground": "#d9a520",
    "gitDecoration.untrackedResourceForeground": "#3fb950",
    "gitDecoration.deletedResourceForeground": "#f14c4c",
    "diffEditor.insertedTextBackground": "#3fb95022",
    "diffEditor.removedTextBackground": "#f14c4c22",

    "notifications.background": "#14141a",
    "notifications.border": "#2e2e36",
    "notificationCenterHeader.background": "#111115",
    "quickInput.background": "#14141a",
    "quickInputList.focusBackground": "#9d6bff33",
    "pickerGroup.foreground": "#b794ff"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b6b78", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#b794ff" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#8fd18f" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#e0a96d" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#7cc4ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#5fd7d7" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#d4d4d8" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#e8c9a0" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#a0a0ac" } },
    { "scope": ["entity.name.tag", "markup.heading"], "settings": { "foreground": "#b794ff" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e0a96d" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#3fb950" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f14c4c" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f14c4c" } }
  ]
}
