    "configuration": {
      "title": "Nexus",
      "properties": {
        "nexus.auth0.domain": {
          "type": "string",
          "default": "dev-1l215or4g4k2ol1x.us.auth0.com",
          "description": "Auth0 tenant host name, for example your-tenant.eu.auth0.com (no https://)."
        },
        "nexus.auth0.clientId": {
          "type": "string",
          "default": "HSwYeHumwswQK0MWUQJX9zOiiSB6yC0k",
          "description": "Client ID of the Auth0 Native application. Not a secret."
        },
        "nexus.auth0.audience": {
          "type": "string",
          "default": "https://nexus-api",
          "description": "Optional API audience to request in the access token."
        },
        "nexus.ciba.serviceUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Nexus auth service. Phone approval (Auth0 push) is off until this is set and you are signed in."
        }
      }
    },
    "themes": [
