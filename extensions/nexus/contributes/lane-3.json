{
  "contributes": {
    "commands": [
      { "command": "nexus.shareSelectionToSlack", "title": "Nexus: Share to Slack" },
      { "command": "nexus.openHome", "title": "Nexus: Open Home" },
      { "command": "nexus.searchEvents", "title": "Nexus: Search events" },
      { "command": "nexus.openTimeline", "title": "Nexus: Open timeline (globe fallback)" },
      { "command": "nexus.openSlack", "title": "Nexus: Open Slack" },
      { "command": "nexus.openApprovals", "title": "Nexus: Open approvals" },
      { "command": "nexus.openSession", "title": "Nexus: Open session" },
      { "command": "nexus.openCommit", "title": "Nexus: Open commit" },
      { "command": "nexus.mergeAgentBranch", "title": "Nexus: Merge agent branch" },
      { "command": "nexus.openReceipt", "title": "Nexus: Open Prune receipt" }
    ],
    "menus": {
      "editor/context": [
        { "command": "nexus.shareSelectionToSlack", "when": "editorHasSelection", "group": "nexus" }
      ],
      "commandPalette": [
        { "command": "nexus.openSession", "when": "false" }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        { "id": "nexus-agent", "title": "Agent", "icon": "resources/nexus.svg" }
      ]
    },
    "views": {
      "nexus": [
        { "type": "webview", "id": "nexus.chat", "name": "Slack" },
        { "type": "webview", "id": "nexus.git", "name": "Git" },
        { "type": "webview", "id": "nexus.approvals", "name": "Approvals" }
      ],
      "nexus-agent": [
        { "type": "webview", "id": "nexus.agent", "name": "Agent" }
      ]
    }
  },
  "activationEvents": []
}
